# Environment Variables for Injective Trading Dashboard
# Copy this file to .env and fill in your values
# NEVER commit .env or real private keys to git!

# Your Injective/Base wallet private key (keep secret!)
INJECTIVE_PRIVATE_KEY=

# Wallet address (public, safe to share)
WALLET_ADDRESS=0x41A9Fbad043922238f0e16EE91d7D9dDC3B44314

# Network: "mainnet" or "testnet"
INJECTIVE_NETWORK=mainnet
